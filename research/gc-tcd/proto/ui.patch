+.legend i.gci-mk-bars { width: 16px; height: 9px; border-radius: 0; background: linear-gradient(#3aa0ff 0 4px, transparent 4px 5px, #ff7a59 5px 9px); }
+.gci-win input { width: 58px; }
+/* (the calibration's plots a strip each, over the levels' table, which is as wide as it needs) */
