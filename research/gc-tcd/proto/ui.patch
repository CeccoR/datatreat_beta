+
+/* ===== GC: a table and its raw chromatograms (v544) =====
+   A pair's row: its two files in FILE, one a line, each with its own small grip (six dots),
+   which drags that file onto another (the row's ≡ still moves the row). Dragging, the whole
+   file it would land on lights (an accent outline), never a gap; off every file, a file with
+   a partner lights itself, dashed: dropped there, it stands alone. A file its pair cannot
+   use (a second table, raw chromatograms beside raw chromatograms) is marked in the warning's
+   colour, its title saying why. */
+td.fname-parts { padding-top: 3px; padding-bottom: 3px; }
+.fparts { flex-direction: column; align-items: stretch; gap: 1px; }
+.fpart { display: flex; align-items: center; gap: 4px; min-width: 0; padding: 1px 4px 1px 0; border-radius: 5px; line-height: 1.35; }
+.fpart-grip { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 12px; height: 16px; color: var(--muted); cursor: grab; touch-action: none; opacity: 0.55; }
+.fpart-grip:hover, .fpart.fdragging .fpart-grip { opacity: 1; color: var(--text); }
+.fdrag-on, .fdrag-on * { cursor: grabbing !important; }
+.fpart.fdragging { opacity: 0.5; }
+.fpart.drop-on { box-shadow: inset 0 0 0 2px var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--text); }
+.fpart.drop-alone { outline: 1.5px dashed var(--accent); outline-offset: -1.5px; opacity: 0.9; }
+.fpart.is-warn .fname-text { color: var(--warn, #d9a21b); text-decoration: underline dotted; text-underline-offset: 2px; }
+
+/* ===== GC: the Integration card (gc-integ.js, v544) ===== */
+.gci-bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 10px; }
+.gci-status { flex: 1 1 260px; min-width: 0; display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--text); }
+.gci-acts { display: flex; gap: 8px; flex-wrap: wrap; }
+.gci-prog { flex: none; width: 140px; height: 6px; border-radius: 3px; background: var(--panel2); border: 1px solid var(--line); overflow: hidden; }
+.gci-prog-bar { display: block; height: 100%; background: var(--accent); transition: width 0.2s; }
+.gci-alerts:not(:empty) { margin-bottom: 10px; }
+.gci-sel { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-bottom: 8px; }
+.gci-nav { display: flex; align-items: center; gap: 6px; min-width: 0; flex: 1 1 280px; }
+.gci-nav select { flex: 1 1 auto; min-width: 0; width: auto; padding: 4px 6px; border-radius: 7px; font: inherit; font-size: 13px; color: var(--text); background: var(--panel2); border: 1px solid var(--line); }
+.gci-notice:not(:empty) { margin-bottom: 8px; }
+.gci-row { align-items: flex-start; }
+.gci-col { min-width: 320px; }
+.gci-legend { margin-top: 6px; }
+.gci-legend i.gci-mk { width: 9px; height: 9px; border-radius: 0; background: none; border: 1.5px solid currentColor; color: var(--muted); }
+.gci-legend i.gci-mk-dot { border-radius: 50%; background: currentColor; }
+.gci-legend i.gci-mk-ring { border-radius: 50%; color: #ff3b3b; width: 11px; height: 11px; }
