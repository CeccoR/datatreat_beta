+    const r = new Float64Array(m);
+    for (let i = 0; i < N; i++) r[i] = (yw[i] - total[i])/noise;
+    let o = N;
+    for (let k = 0; k < npk; k++) for (let i = 0; i < NPR; i++) r[o++] = w*((p[NP*k + 2 + i] - PRIOR_MEAN[i])/PRIOR_SD[i]);
