+    restarted = true;
+    const r2 = fitOnce(t, y, win, fit, { excluded });
+    nfevTotal += r2.nfev;
+    if (r2.cost < r.cost){ r = r2; restartWon = true; }
+  }
+  r.excluded = excluded; r.nfevTotal = nfevTotal; r.restarted = restarted; r.restartWon = restartWon;
