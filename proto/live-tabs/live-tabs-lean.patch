@@ -0,0 +1,5 @@
+/* The techniques' modules: all of them; in a live tab's page (index.html?embed=<tab id>&m=
+   <module>, live tabs, prototype) its own alone, the other four neither loaded nor wired.
+   tabs.js imports this file, so it is evaluated once they all are (its pristine states). */
+const one = document.documentElement.classList.contains('embed') && (/[?&]m=(tauc|xrd|epr|gc|sem)(?:[&#]|$)/.exec(location.search) || [])[1];
+await Promise.all(['tauc', 'xrd', 'epr', 'gc', 'sem'].filter(m=> !one || m === one).map(m=> import('./' + m + '.js')));
