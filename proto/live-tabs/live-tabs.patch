+.live-frames { position: fixed; left: 0; right: 0; bottom: 0; top: 0; z-index: 10; background: var(--bg); }
+.live-frames[hidden] { display: none; }
+.live-frames > iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; background: var(--bg); }
+.live-frames > iframe.off { display: none; }
+/* (measured against: hidden but laid out, its plots kept at their size) */
