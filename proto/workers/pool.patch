+      try {
+        const { pay, ctx } = payload(k);
+        on.set(k, 0); tell(k, '', 'start');
+        j = job(pay, (f, stage)=>{ if (on.has(k)){ on.set(k, f); tell(k, stage, 'progress'); } });
