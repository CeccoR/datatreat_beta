+test('two DRS tabs awake at once: each its own files, cards and undo; a switch to one awake only shows it, its plots not drawn again', async ()=>{
+  const { page, errors, close } = await env.page();
+  try {
+    const [d1, d2] = env.fx.files.tauc;
+    await openModule(page, 'tauc'); await loadFiles(page, 'tauc', [d1, d2]);
+    await relabel(page, 0, 'a-one');
+    await exponent(page, '2');
+    const egA = await text(page, '#an1Eg');
+    // (its section and a curve of its card's plot, marked: the same elements when it is shown again)
+    await page.evaluate(()=>{ document.querySelector('#tab-tauc').dataset.mark = 'A'; document.querySelector('#an1Svg path').dataset.mark = 'A'; });
+    await openModule(page, 'tauc'); await loadFiles(page, 'tauc', [d2]);
+    assert.deepEqual(await awake(page), [true, true], 'both awake');
+    assert.equal(await page.locator('#tab-tauc').count(), 1, 'one DRS section in the page, the one on show');
+    assert.equal(await page.inputValue('#an1A'), '0.5', 'B its own card, at the default exponent');
+    await relabel(page, 0, 'b-one');
+    await switchTab(page, 0);
+    assert.equal(await page.evaluate(()=> document.querySelector('#tab-tauc').dataset.mark), 'A', 'tab A\'s own section, shown again');
+    assert.equal(await page.locator('#an1Svg path[data-mark="A"]').count(), 1, 'its plot as it was left, not drawn again');
+    assert.deepEqual(await labels(page), ['a-one', 'drs2']);
+    assert.equal(await page.inputValue('#an1A'), '2');
+    assert.equal(await text(page, '#an1Eg'), egA);
+    assert.deepEqual(await history(page, 'tauc'), { index: 4, n: 5 }, 'its history: start, files, their lines placed, label, exponent');
+    // Undo in A undoes A's steps alone; B keeps its own.
+    await undo(page); await undo(page);
+    assert.deepEqual(await labels(page), ['drs1', 'drs2']);
+    assert.equal(await page.inputValue('#an1A'), '0.5');
+    await switchTab(page, 1);
+    assert.deepEqual(await labels(page), ['b-one']);
+    await undo(page);
+    assert.deepEqual(await labels(page), ['drs2']);
+    await switchTab(page, 0);
+    await undo(page, true); await undo(page, true);
+    assert.deepEqual(await labels(page), ['a-one', 'drs2'], 'A\'s redo, after B\'s undo');
+    assert.equal(await text(page, '#an1Eg'), egA);
+    assert.deepEqual(errors, []);
+  } finally { await close(); }
+});
+
+test('a DRS tab asleep past Settings\' minutes, its instance let go; woken with its cards and its whole history', async ()=>{
+  const { page, errors, close } = await env.page();
+  try {
+    await page.evaluate(async ()=>{ const u = await import('./utils.js'); Object.assign(u.settings, { sleepMin: 10, awakeMax: 7 }); });
+    await newTab(page); await drop(page, env.fx.files.tauc);
+    await relabel(page, 0, 'x');
+    await exponent(page, '2');
+    // An Urbach card, from the kinds' menu (in the instance's layer).
+    await page.click('#taucAddAn');
+    await page.click('.an-menu button[data-kind="urbach"]');
+    await page.waitForFunction(()=> !!document.querySelector('#an2Eu')); await settle(page);
+    await relabel(page, 1, 'y');
+    const before = { state: await moduleState(page, 'tauc'), h: await history(page, 'tauc'), eg: await text(page, '#an1Eg'), eu: await text(page, '#an2Eu') };
+    assert.notEqual(before.eu, '-');
+    await page.evaluate(async ()=>{ window.__root = new WeakRef((await import('./tabs.js')).TABS[0].inst.root); });
+    await openModule(page, 'tauc');
+    await tick(page, 9*MIN);
+    assert.deepEqual(await awake(page), [true, true], '9 minutes hidden: awake');
+    await tick(page, 11*MIN);
+    assert.deepEqual(await awake(page), [false, true], '11 minutes: asleep');
+    assert.equal((await tabs(page))[0].history, true, 'its history parked with it');
+    // Its instance let go: nothing holds its section once the page is collected.
+    const cdp = await page.context().newCDPSession(page);
+    for (let i = 0; i < 3; i++){ await cdp.send('HeapProfiler.collectGarbage'); await page.waitForTimeout(100); }
+    assert.equal(await page.evaluate(()=> window.__root.deref() === undefined), true, 'its section collected');
+    // Woken: its state, its cards and their results, its whole history.
+    await switchTab(page, 0);
+    assert.deepEqual(await awake(page), [true, true]);
+    assert.deepEqual(await moduleState(page, 'tauc'), before.state);
+    assert.deepEqual(await history(page, 'tauc'), before.h);
+    assert.equal(await text(page, '#an1Eg'), before.eg);
+    assert.equal(await text(page, '#an2Eu'), before.eu);
+    assert.ok(await page.locator('#an2Svg path').count() > 0, 'the Urbach card drawn');
+    // Undone step by step to the empty start, and redone to where it was.
+    await undo(page); assert.deepEqual(await labels(page), ['x', 'drs2']);
+    await undo(page); assert.equal(await page.locator('#an2Eu').count(), 0, 'the Urbach card undone');
+    await undo(page); assert.equal(await page.inputValue('#an1A'), '0.5');
+    await undo(page); assert.deepEqual(await labels(page), ['drs1', 'drs2']);
+    // (the files, then their lines placed: two steps)
+    await undo(page); await undo(page); assert.deepEqual(await labels(page), [], 'down to the empty start');
+    assert.equal((await history(page, 'tauc')).index, 0);
+    for (let i = 0; i < 6; i++) await undo(page, true);
+    assert.deepEqual(await moduleState(page, 'tauc'), before.state, 'and up again');
+    assert.equal(await text(page, '#an2Eu'), before.eu);
+    assert.deepEqual(errors, []);
+  } finally { await close(); }
+});
diff --git a/tests/b2fixed.test.mjs b/tests/b2fixed.test.mjs
new file mode 100644
index 0000000..f6cc1c1
--- /dev/null
+++ b/tests/b2fixed.test.mjs
@@ -0,0 +1,72 @@
+/* Arrays fixed (db.js fixed, b2v3): an array a module makes and never changes, marked so,
+   shared by park and decode, not copied, and not frozen (to b2v2 XRPD's were frozen, which
+   holds a double in twice the memory, and DRS's, GC's and EPR's were copied into every
+   state parked). In Node: park and decode give a fixed array back as it is and copy one
+   not fixed; encode writes both out alike. In the page, the tests' freezing of each fixed
+   array off (window.__freezeFixed): a tab of XRPD, DRS, GC and EPR asleep, its parked
+   state holding its history's arrays, none frozen; woken, its instance's the same arrays;
+   the history's key of a state (stateKey) taking a fixed array by its hash. With the
+   freezing on, as in every other test, a fixed array is frozen, so that a write throws. */
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { start, openModule, loadFiles, settle, ready } from './helpers.mjs';
+
+const db = await import('../db.js');
+
+test('park and decode share a fixed array and copy one not fixed; encode writes both out', ()=>{
+  const x = db.fixed([1.5, 2.5, 3.5]), y = [4.5, 5.5], s = { files: [{ x, y, n: 'a' }], d: new Date(0) };
+  const p = db.park(s), back = db.decode(p);
+  assert.equal(p.files[0].x, x, 'parked: the fixed array itself');
+  assert.notEqual(p.files[0].y, y, 'parked: a copy of one not fixed');
+  assert.deepEqual(p.files[0].y, y);
+  assert.equal(back.files[0].x, x, 'decoded: the fixed array itself');
+  assert.notEqual(back.files[0].y, p.files[0].y);
+  assert.ok(db.isFixed(x) && !db.isFixed(y) && !Object.isFrozen(x), 'fixed, not frozen');
+  assert.equal(db.fixed(x), x);
+  assert.deepEqual(JSON.parse(JSON.stringify(db.encode(s))).files[0], { x: [1.5, 2.5, 3.5], y: [4.5, 5.5], n: 'a' });
+});
+
+let env;
+before(async ()=>{ env = await start(); });
+after(()=> env && env.close());
+
+const FILES = ()=> ({ xrd: env.fx.files.xrd, tauc: env.fx.files.tauc, gc: env.fx.files.gc, epr: env.fx.files.epr });
+
+test('a tab of each module asleep holds its history\'s arrays, not frozen; woken, the same; stateKey by hash; a write into a fixed array throws where the tests freeze them', async ()=>{
+  const { page, errors, csp, close } = await env.page();
+  try {
+    await page.addInitScript(()=>{ window.__freezeFixed = false; });
+    await page.reload(); await ready(page);
+    for (const [mod, files] of Object.entries(FILES())){ await openModule(page, mod); await loadFiles(page, mod, files); }
+    await openModule(page, 'gc');
+    const arrays = ()=> page.evaluate(async ()=>{
+      const T = await import('./tabs.js'), u = await import('./utils.js'), db = await import('./db.js');
+      const nums = (v, out = [])=>{ if (Array.isArray(v) && db.isFixed(v)) out.push(v); else if (v && typeof v === 'object' && !ArrayBuffer.isView(v)) for (const k in v) nums(v[k], out); return out; };
+      window.__a = window.__a || {};
+      return T.TABS.slice(0, 4).map(t=>{
+        if (t.inst){ const a = nums(u.getModuleState(t.id)); const was = window.__a[t.id]; window.__a[t.id] = a;
+          return { mod: t.module, awake: true, n: a.length, same: !!was && a.length === was.length && a.every(x=> was.includes(x)), frozen: a.filter(Object.isFrozen).length }; }
+        const p = nums(t.state), h = new Set(t.hist.states.flatMap(s=> nums(s)));
+        window.__a[t.id] = p;
+        return { mod: t.module, awake: false, n: p.length, shared: p.filter(x=> h.has(x)).length, frozen: p.filter(Object.isFrozen).length };
+      });
+    });
+    await page.evaluate(async ()=> (await import('./tabs.js')).sleepTick(Date.now() + 11*60e3));
+    const asleep = await arrays();
+    // (XRPD: 2θ and intensities of 3 patterns; DRS: λ and F(R) of 2; GC: H₂ of 2 and O₂ of 1; EPR: field and intensities of 2)
+    assert.deepEqual(asleep.map(t=> [t.mod, t.awake, t.n, t.shared, t.frozen]),
+      [['xrd', false, 6, 6, 0], ['tauc', false, 4, 4, 0], ['gc', false, 3, 3, 0], ['epr', false, 4, 4, 0]]);
+    for (let i = 0; i < 4; i++){ await page.locator('#tabBar .ptab').nth(i).locator('.ptab-label').click(); await settle(page); }
+    const woken = await arrays();
+    assert.deepEqual(woken.map(t=> [t.mod, t.awake, t.n, t.same, t.frozen]),
+      [['xrd', true, 6, true, 0], ['tauc', true, 4, true, 0], ['gc', true, 3, true, 0], ['epr', true, 4, true, 0]], 'woken: the arrays it slept with');
+    assert.ok(await page.evaluate(async ()=>{ const u = await import('./utils.js'); return /^\{"x":"nums:3:/.test(u.stateKey({ x: u.fixed([1, 2, 3]) })); }));
+    // With the tests' freezing on, a fixed array is frozen: a write into it, in the app's
+    // modules (strict), throws.
+    await page.addInitScript(()=>{ window.__freezeFixed = true; });
+    await page.reload(); await ready(page);
+    assert.ok(await page.evaluate(async ()=> Object.isFrozen((await import('./db.js')).fixed([1, 2]))));
+    assert.deepEqual(errors, []);
+    assert.deepEqual(await csp(), []);
+  } finally { await close(); }
+});
diff --git a/tests/b2gcepr.test.mjs b/tests/b2gcepr.test.mjs
new file mode 100644
index 0000000..726e357
--- /dev/null
+++ b/tests/b2gcepr.test.mjs
@@ -0,0 +1,128 @@
+/* GC and EPR made per tab (b2): each GC or EPR tab an instance of its own in one page. For
+   each module, two tabs awake at once, each its own files, parameters, results, view and
+   undo history; a switch to one awake only showing it (its own section, its plots as they
+   were, not drawn again); undo and redo in one leaving the other's steps alone; a tab hidden
+   past Settings' minutes asleep (tabs.js sleepTick: the time taken to be later), its
+   instance let go (a WeakRef to its section emptied by a GC), woken with its state, its
+   results and its whole history, undone step by step to the empty start and redone. */
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { start, switchTab, settle, undo, moduleState, history } from './helpers.mjs';
+
+let env;
+before(async ()=>{ env = await start(); });
+after(()=> env && env.close());
+
+const tabs = page => page.evaluate(async ()=> (await import('./tabs.js')).tabsNow());
+const awake = async page => (await tabs(page)).map(t=> t.awake);
+const tick = (page, ms)=> page.evaluate(async ms=> (await import('./tabs.js')).sleepTick(Date.now() + ms), ms);
+const MIN = 60000;
+const labels = async (page, mod)=> (await moduleState(page, mod)).files.map(f=> f.label);
+async function relabel(page, mod, v){ const l = page.locator(`#${mod}FileTableWrap .file-label[data-i="0"]`); await l.fill(v); await l.press('Enter'); await settle(page); }
+const type = async (page, sel, v)=>{ await page.fill(sel, v); await page.press(sel, 'Enter'); await settle(page); };
+/* A new tab of the module, and files dropped (a DragEvent), with no element handle kept:
+   Playwright's setInputFiles keeps a hold on the input it filled, and a handle not disposed
+   (openModule's waitForSelector) on its element, and so on its instance, which a tab
+   asleep would then never let go. */
+async function newTab(page, mod){
+  await page.click('#nav button[data-tab="home"]');
+  await page.click(`.home-card[data-go="${mod}"]`);
+  await page.waitForFunction(mod=> !!document.querySelector(`#tab-${mod}.active`), mod);
+  await settle(page);
+}
+async function drop(page, mod, files, rows){
+  const n0 = await page.locator(`#${mod}FileTableWrap tr.file-row`).count();
+  const list = files.map(f=> [path.basename(f), fs.readFileSync(f).toString('base64')]);
+  await page.evaluate(([mod, list])=>{
+    const dt = new DataTransfer();
+    for (const [name, b64] of list) dt.items.add(new File([Uint8Array.from(atob(b64), c=> c.charCodeAt(0))], name));
+    document.querySelector(`#${mod}Dropzone`).dispatchEvent(new DragEvent('drop', { dataTransfer: dt, bubbles: true, cancelable: true }));
+  }, [mod, list]);
+  await page.waitForFunction(([mod, n])=> document.querySelectorAll(`#${mod}FileTableWrap tr.file-row`).length >= n && !document.querySelector('.dz-loading'), [mod, n0 + rows]);
+  await settle(page);
+}
+/* Each module: its files for tab A and tab B, a parameter of its card (its field, its
+   default, the value A sets), and what its results show, read in the page: GC's mean-rate
+   bars (their labels and values), EPR's plot (its paths' coordinates). A plot drawn during
+   a tab's fade in (style.css tab-fade: a redo just after a switch, a wake) measures its box
+   moved by a fraction of a pixel, which can turn a coordinate's second decimal: the
+   coordinates are the same to 0.02 px. */
+const MODS = {
+  gc: { a: fx => [fx.gc[0]], b: fx => [fx.gc[1]], rows: 1, field: '#tab-gc .gcShared[data-f="m"]', def: '15', set: '30', plot: '#gc1Svg1',
+    shows: page => page.$$eval('#gc1SvgBar text', ts=> ts.map(t=> t.textContent)),
+    same: (a, b)=> assert.deepEqual(a, b) },
+  epr: { a: fx => fx.epr.slice(0, 2), b: fx => fx.epr.slice(2, 4), rows: 1, field: '#epr1Smooth', def: '0.2', set: '0.5', plot: '#epr1Svg',
+    shows: page => page.$$eval('#epr1Svg path', ps=> ps.map(p=> (p.getAttribute('d') || '').match(/-?[\d.]+/g) || []).flat().map(Number)),
+    same: (a, b)=>{ assert.equal(a.length, b.length); assert.ok(a.every((v, i)=> Math.abs(v - b[i]) <= 0.02), 'the same plot'); } },
+};
+
+for (const [mod, M] of Object.entries(MODS)) test(`${mod.toUpperCase()}: two tabs awake at once, each its own files, parameters, results and undo; one asleep past Settings' minutes, let go, woken with its whole history`, async ()=>{
+  const { page, errors, close } = await env.page();
+  try {
+    await page.evaluate(async ()=>{ const u = await import('./utils.js'); Object.assign(u.settings, { sleepMin: 10, awakeMax: 7 }); });
+    const fx = env.fx.files, value = ()=> page.inputValue(M.field);
+    // Tab A: its files, its parameter and a label.
+    await newTab(page, mod); await drop(page, mod, M.a(fx), M.rows);
+    const la = await labels(page, mod);
+    await type(page, M.field, M.set);
+    await relabel(page, mod, 'a-one');
+    const A = { state: await moduleState(page, mod), h: await history(page, mod), shows: await M.shows(page) };
+    assert.ok(A.shows.length, 'its results shown');
+    // (its section and a curve of its plot, marked: the same elements when it is shown again)
+    await page.evaluate(([mod, plot])=>{ document.querySelector(`#tab-${mod}`).dataset.mark = 'A'; document.querySelector(plot + ' path').dataset.mark = 'A'; }, [mod, M.plot]);
+    await page.evaluate(async ()=>{ window.__root = new WeakRef((await import('./tabs.js')).TABS[0].inst.root); });
+    // Tab B: its own files, the parameter at its default.
+    await newTab(page, mod); await drop(page, mod, M.b(fx), M.rows);
+    assert.deepEqual(await awake(page), [true, true], 'both awake');
+    assert.equal(await page.locator(`#tab-${mod}`).count(), 1, 'one section of the module in the page, the one on show');
+    assert.equal(await value(), M.def, 'B its own card, at the default');
+    const lb = await labels(page, mod);
+    assert.notDeepEqual(lb, la);
+    await relabel(page, mod, 'b-one');
+    // A shown again: its own section, its plot as it was left, its state, results and history.
+    await switchTab(page, 0);
+    assert.equal(await page.evaluate(mod=> document.querySelector(`#tab-${mod}`).dataset.mark, mod), 'A', 'tab A\'s own section, shown again');
+    assert.equal(await page.locator(M.plot + ' path[data-mark="A"]').count(), 1, 'its plot as it was left, not drawn again');
+    assert.deepEqual(await moduleState(page, mod), A.state);
+    M.same(await M.shows(page), A.shows);
+    assert.deepEqual(await history(page, mod), A.h);
+    // Undo in A undoes A's steps alone; B keeps its own.
+    await undo(page); assert.deepEqual(await labels(page, mod), la);
+    await undo(page); assert.equal(await value(), M.def);
+    await switchTab(page, 1);
+    assert.deepEqual(await labels(page, mod), ['b-one']);
+    await undo(page); assert.deepEqual(await labels(page, mod), lb);
+    await switchTab(page, 0);
+    await undo(page, true); await undo(page, true);
+    assert.deepEqual(await moduleState(page, mod), A.state, 'A\'s redo, after B\'s undo');
+    M.same(await M.shows(page), A.shows);
+    // A hidden: awake 9 minutes on, asleep at 11, its history parked, its instance let go.
+    await switchTab(page, 1);
+    await tick(page, 9*MIN);
+    assert.deepEqual(await awake(page), [true, true], '9 minutes hidden: awake');
+    await tick(page, 11*MIN);
+    assert.deepEqual(await awake(page), [false, true], '11 minutes: asleep');
+    assert.equal((await tabs(page))[0].history, true, 'its history parked with it');
+    const cdp = await page.context().newCDPSession(page);
+    for (let i = 0; i < 3; i++){ await cdp.send('HeapProfiler.collectGarbage'); await page.waitForTimeout(100); }
+    assert.equal(await page.evaluate(()=> window.__root.deref() === undefined), true, 'its section collected');
+    // Woken: its state, its results, its whole history; undone step by step to the empty
+    // start, and redone to where it was.
+    await switchTab(page, 0);
+    assert.deepEqual(await awake(page), [true, true]);
+    assert.deepEqual(await moduleState(page, mod), A.state);
+    assert.deepEqual(await history(page, mod), A.h);
+    M.same(await M.shows(page), A.shows);
+    await undo(page); assert.deepEqual(await labels(page, mod), la);
+    await undo(page); assert.equal(await value(), M.def);
+    for (let i = A.h.index - 2; i > 0; i--) await undo(page);
+    assert.deepEqual(await labels(page, mod), [], 'down to the empty start');
+    assert.equal((await history(page, mod)).index, 0);
+    for (let i = 0; i < A.h.index; i++) await undo(page, true);
+    assert.deepEqual(await moduleState(page, mod), A.state, 'and up again');
+    M.same(await M.shows(page), A.shows);
+    assert.deepEqual(errors, []);
+  } finally { await close(); }
+});
diff --git a/tests/b2kept.test.mjs b/tests/b2kept.test.mjs
new file mode 100644
index 0000000..53129e3
--- /dev/null
+++ b/tests/b2kept.test.mjs
@@ -0,0 +1,313 @@
+/* What is worked out, kept (b2v3): a tab woken from sleep, an undo, a redraw take what was
+   worked out before (utils.js keeper: by the data's array and every other input), and make
+   none of it again. Counted (utils.js kept.made: the results made, by name) across each
+   wake; the plots drawn from what was kept, against the golden hashes the plots' test takes
+   of a first drawing (plots.test.mjs: the same files and steps) and against the same tab's
+   own before it slept; its CSVs byte for byte. A parameter changed makes its results again,
+   and an undo back to it takes them as kept. XRPD (its patterns' processing, its Rietveld
+   curves), DRS (every fit, a Tauc and an Urbach card), GC and EPR (their tables and
+   smoothing), SEM (its thumbnails and cards, kept while the tab is asleep, its bytes let
+   go). The tab woken shows under the loader; one awake shown at another width of the
+   window, too, and a project written to a file (b2v3's loader). */
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { start, openModule, loadFiles, switchTab, settle, undo, poke, plotSvgs, golden, download, readZip, saveAs } from './helpers.mjs';
+import { makeTiff } from './fixtures.mjs';
+
+let env;
+before(async ()=>{ env = await start(); });
+after(()=> env && env.close());
+
+const MIN = 60000;
+const tabs = page => page.evaluate(async ()=> (await import('./tabs.js')).tabsNow());
+const tick = (page, ms)=> page.evaluate(async ms=> (await import('./tabs.js')).sleepTick(Date.now() + ms), ms);
+const made = page => page.evaluate(async ()=> JSON.parse(JSON.stringify((await import('./utils.js')).kept)));
+/* Every plot drawn again at a settled layout: the window narrowed and widened back (a plot
+   drawn as its section is put in the page, a wake's, can differ in its last digit, as the
+   plots' test says of a first drawing; one drawn again at the same size is kept as it is). */
+async function redraw(page){
+  for (const width of [1380, 1400]){ await page.setViewportSize({ width, height: 900 }); await page.waitForTimeout(400); await settle(page); }
+}
+const csvs = async page => readZip((await download(page, ()=> page.click('.proj-csv'))).buf).map(e=> [e.name, e.data.toString('utf8')]);
+// Tab i put to sleep from tab j (11 minutes hidden), then shown: woken, the loader on.
+async function sleepWake(page, i, j){
+  await switchTab(page, j);
+  await tick(page, 11*MIN);
+  assert.equal((await tabs(page))[i].awake, false, 'asleep');
+  await page.locator('#tabBar .ptab').nth(i).locator('.ptab-label').click();
+  assert.equal(await page.evaluate(()=> !!document.querySelector('.module-loader.show')), true, 'the loader on as it wakes');
+  await settle(page);
