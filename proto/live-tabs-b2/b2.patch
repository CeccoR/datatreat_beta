+    // By memory: past the MB allowed (its estimate, tabs.js bytes) the tab hidden sleeps.
+    await page.evaluate(async ()=>{ const u = await import('./utils.js'); u.settings.livePolicy = 'memory'; u.settings.liveMB = 1; });
