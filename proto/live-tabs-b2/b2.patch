@@ -0,0 +1,128 @@
+/* GC and EPR made per tab (b2): each GC or EPR tab an instance of its own in one page. For
+   each module, two tabs awake at once, each its own files, parameters, results, view and
+   undo history; a switch to one awake only showing it (its own section, its plots as they
+   were, not drawn again); undo and redo in one leaving the other's steps alone; a tab hidden
+   past Settings' minutes asleep (tabs.js sleepTick: the time taken to be later), its
+   instance let go (a WeakRef to its section emptied by a GC), woken with its state, its
+   results and its whole history, undone step by step to the empty start and redone. */
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { start, switchTab, settle, undo, moduleState, history } from './helpers.mjs';
+
+let env;
+before(async ()=>{ env = await start(); });
+after(()=> env && env.close());
+
+const tabs = page => page.evaluate(async ()=> (await import('./tabs.js')).tabsNow());
+const awake = async page => (await tabs(page)).map(t=> t.awake);
+const tick = (page, ms)=> page.evaluate(async ms=> (await import('./tabs.js')).sleepTick(Date.now() + ms), ms);
+const MIN = 60000;
+const labels = async (page, mod)=> (await moduleState(page, mod)).files.map(f=> f.label);
+async function relabel(page, mod, v){ const l = page.locator(`#${mod}FileTableWrap .file-label[data-i="0"]`); await l.fill(v); await l.press('Enter'); await settle(page); }
+const type = async (page, sel, v)=>{ await page.fill(sel, v); await page.press(sel, 'Enter'); await settle(page); };
+/* A new tab of the module, and files dropped (a DragEvent), with no element handle kept:
+   Playwright's setInputFiles keeps a hold on the input it filled, and a handle not disposed
+   (openModule's waitForSelector) on its element, and so on its instance, which a tab
+   asleep would then never let go. */
+async function newTab(page, mod){
+  await page.click('#nav button[data-tab="home"]');
+  await page.click(`.home-card[data-go="${mod}"]`);
+  await page.waitForFunction(mod=> !!document.querySelector(`#tab-${mod}.active`), mod);
+  await settle(page);
+}
+async function drop(page, mod, files, rows){
+  const n0 = await page.locator(`#${mod}FileTableWrap tr.file-row`).count();
+  const list = files.map(f=> [path.basename(f), fs.readFileSync(f).toString('base64')]);
+  await page.evaluate(([mod, list])=>{
+    const dt = new DataTransfer();
+    for (const [name, b64] of list) dt.items.add(new File([Uint8Array.from(atob(b64), c=> c.charCodeAt(0))], name));
+    document.querySelector(`#${mod}Dropzone`).dispatchEvent(new DragEvent('drop', { dataTransfer: dt, bubbles: true, cancelable: true }));
+  }, [mod, list]);
+  await page.waitForFunction(([mod, n])=> document.querySelectorAll(`#${mod}FileTableWrap tr.file-row`).length >= n && !document.querySelector('.dz-loading'), [mod, n0 + rows]);
+  await settle(page);
+}
+/* Each module: its files for tab A and tab B, a parameter of its card (its field, its
+   default, the value A sets), and what its results show, read in the page: GC's mean-rate
+   bars (their labels and values), EPR's plot (its paths' coordinates). A plot drawn during
+   a tab's fade in (style.css tab-fade: a redo just after a switch, a wake) measures its box
+   moved by a fraction of a pixel, which can turn a coordinate's second decimal: the
+   coordinates are the same to 0.02 px. */
+const MODS = {
+  gc: { a: fx => [fx.gc[0]], b: fx => [fx.gc[1]], rows: 1, field: '#tab-gc .gcShared[data-f="m"]', def: '15', set: '30', plot: '#gc1Svg1',
+    shows: page => page.$$eval('#gc1SvgBar text', ts=> ts.map(t=> t.textContent)),
+    same: (a, b)=> assert.deepEqual(a, b) },
+  epr: { a: fx => fx.epr.slice(0, 2), b: fx => fx.epr.slice(2, 4), rows: 1, field: '#epr1Smooth', def: '0.2', set: '0.5', plot: '#epr1Svg',
+    shows: page => page.$$eval('#epr1Svg path', ps=> ps.map(p=> (p.getAttribute('d') || '').match(/-?[\d.]+/g) || []).flat().map(Number)),
+    same: (a, b)=>{ assert.equal(a.length, b.length); assert.ok(a.every((v, i)=> Math.abs(v - b[i]) <= 0.02), 'the same plot'); } },
+};
+
+for (const [mod, M] of Object.entries(MODS)) test(`${mod.toUpperCase()}: two tabs awake at once, each its own files, parameters, results and undo; one asleep past Settings' minutes, let go, woken with its whole history`, async ()=>{
+  const { page, errors, close } = await env.page();
+  try {
+    await page.evaluate(async ()=>{ const u = await import('./utils.js'); Object.assign(u.settings, { sleepMin: 10, livePolicy: 'count', liveMax: 6 }); });
+    const fx = env.fx.files, value = ()=> page.inputValue(M.field);
+    // Tab A: its files, its parameter and a label.
+    await newTab(page, mod); await drop(page, mod, M.a(fx), M.rows);
+    const la = await labels(page, mod);
+    await type(page, M.field, M.set);
+    await relabel(page, mod, 'a-one');
+    const A = { state: await moduleState(page, mod), h: await history(page, mod), shows: await M.shows(page) };
+    assert.ok(A.shows.length, 'its results shown');
+    // (its section and a curve of its plot, marked: the same elements when it is shown again)
+    await page.evaluate(([mod, plot])=>{ document.querySelector(`#tab-${mod}`).dataset.mark = 'A'; document.querySelector(plot + ' path').dataset.mark = 'A'; }, [mod, M.plot]);
+    await page.evaluate(async ()=>{ window.__root = new WeakRef((await import('./tabs.js')).TABS[0].inst.root); });
+    // Tab B: its own files, the parameter at its default.
+    await newTab(page, mod); await drop(page, mod, M.b(fx), M.rows);
+    assert.deepEqual(await awake(page), [true, true], 'both awake');
+    assert.equal(await page.locator(`#tab-${mod}`).count(), 1, 'one section of the module in the page, the one on show');
+    assert.equal(await value(), M.def, 'B its own card, at the default');
+    const lb = await labels(page, mod);
+    assert.notDeepEqual(lb, la);
+    await relabel(page, mod, 'b-one');
+    // A shown again: its own section, its plot as it was left, its state, results and history.
+    await switchTab(page, 0);
+    assert.equal(await page.evaluate(mod=> document.querySelector(`#tab-${mod}`).dataset.mark, mod), 'A', 'tab A\'s own section, shown again');
+    assert.equal(await page.locator(M.plot + ' path[data-mark="A"]').count(), 1, 'its plot as it was left, not drawn again');
+    assert.deepEqual(await moduleState(page, mod), A.state);
+    M.same(await M.shows(page), A.shows);
+    assert.deepEqual(await history(page, mod), A.h);
+    // Undo in A undoes A's steps alone; B keeps its own.
+    await undo(page); assert.deepEqual(await labels(page, mod), la);
+    await undo(page); assert.equal(await value(), M.def);
+    await switchTab(page, 1);
+    assert.deepEqual(await labels(page, mod), ['b-one']);
+    await undo(page); assert.deepEqual(await labels(page, mod), lb);
+    await switchTab(page, 0);
+    await undo(page, true); await undo(page, true);
+    assert.deepEqual(await moduleState(page, mod), A.state, 'A\'s redo, after B\'s undo');
+    M.same(await M.shows(page), A.shows);
+    // A hidden: awake 9 minutes on, asleep at 11, its history parked, its instance let go.
+    await switchTab(page, 1);
+    await tick(page, 9*MIN);
+    assert.deepEqual(await awake(page), [true, true], '9 minutes hidden: awake');
+    await tick(page, 11*MIN);
+    assert.deepEqual(await awake(page), [false, true], '11 minutes: asleep');
+    assert.equal((await tabs(page))[0].history, true, 'its history parked with it');
+    const cdp = await page.context().newCDPSession(page);
+    for (let i = 0; i < 3; i++){ await cdp.send('HeapProfiler.collectGarbage'); await page.waitForTimeout(100); }
+    assert.equal(await page.evaluate(()=> window.__root.deref() === undefined), true, 'its section collected');
+    // Woken: its state, its results, its whole history; undone step by step to the empty
+    // start, and redone to where it was.
+    await switchTab(page, 0);
+    assert.deepEqual(await awake(page), [true, true]);
+    assert.deepEqual(await moduleState(page, mod), A.state);
+    assert.deepEqual(await history(page, mod), A.h);
+    M.same(await M.shows(page), A.shows);
+    await undo(page); assert.deepEqual(await labels(page, mod), la);
+    await undo(page); assert.equal(await value(), M.def);
+    for (let i = A.h.index - 2; i > 0; i--) await undo(page);
+    assert.deepEqual(await labels(page, mod), [], 'down to the empty start');
+    assert.equal((await history(page, mod)).index, 0);
+    for (let i = 0; i < A.h.index; i++) await undo(page, true);
+    assert.deepEqual(await moduleState(page, mod), A.state, 'and up again');
+    M.same(await M.shows(page), A.shows);
+    assert.deepEqual(errors, []);
+  } finally { await close(); }
+});
diff --git a/tests/b2sem.test.mjs b/tests/b2sem.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8be77c1273682b2813cbb1ce29d38f6a4f668313
--- /dev/null
+++ b/tests/b2sem.test.mjs
@@ -0,0 +1,161 @@
+/* SEM made per tab (b2): each SEM tab an instance of its own, awake while it is shown or
+   was lately, in one page. Two tabs awake at once, each its own files, view and undo
+   history, a switch to one awake only showing it (the same section, nothing restored); a
+   file in both one array of bytes, and one reading worker for both; a reading going on in
+   a tab left, nothing asked, its files landing in its own list as one step, its record
+   and its "*", its tab awake till then and its time hidden counted from its end; a tab
+   hidden letting go of the editor's image at once and of what it drew at its trim, drawn
+   again as it is shown; asleep past Settings' minutes, woken with its whole history.
+   The worker's answers held where a reading must go on (window.__hold). */
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { start, openModule, loadFiles, switchTab, settle, undo, moduleState, history, idb, banner, until, tabLabels } from './helpers.mjs';
+import { tif } from './fixtures.mjs';
+
+let env;
+before(async ()=>{ env = await start(); });
+after(()=> env && env.close());
+
+// The shell's tabs (tabs.js tabsNow), and its rules run as if `ms` had passed.
+const tabs = page => page.evaluate(async ()=> (await import('./tabs.js')).tabsNow());
+const awake = async page => (await tabs(page)).map(t=> t.awake);
+const tick = (page, ms)=> page.evaluate(async ms=> (await import('./tabs.js')).sleepTick(Date.now() + ms), ms);
+const MIN = 60000;
+const labels = async page => (await moduleState(page, 'sem')).files.map(f=> f.label);
+async function relabel(page, i, v){ const l = page.locator(`#semFileTableWrap .file-label[data-i="${i}"]`); await l.fill(v); await l.press('Enter'); await settle(page); }
+const thumbs = (page, n)=> page.waitForFunction(n=> document.querySelectorAll('#semThumbs .sem-thumb canvas').length === n, n);
+// (a: 16 bits, its image a view of its bytes; b, c: 8 bits, a copy)
+const A = ()=> tif('a.tif', { sign: 'A', seed: 1, pixelNm: 25, mag: 5000, bits: 16 });
+const B = ()=> tif('b.tif', { sign: 'B', seed: 2, pixelNm: 25, mag: 5000 });
+const C = ()=> tif('c.tif', { sign: 'C', seed: 3, pixelNm: 100, mag: 1250 });
+// The reading worker's answers held while __hold, delivered by __release(); the workers made counted.
+const holdWorkers = page => page.evaluate(()=>{
+  const W = window.Worker; window.__held = []; window.__hold = false; window.__made = 0;
+  const wrap = fn => e=>{ if (window.__hold && e.data && e.data.seq != null) window.__held.push(()=> fn(e)); else fn(e); };
+  window.Worker = class extends W {
+    constructor(...a){ super(...a); window.__made++; }
+    set onmessage(fn){ super.onmessage = fn && wrap(fn); }
+    get onmessage(){ return super.onmessage; }
+  };
+  window.__release = ()=>{ window.__hold = false; window.__held.splice(0).forEach(f=> f()); };
+});
+
+test('two SEM tabs awake at once: each its own files, view and undo; a file in both one array, one worker for both', async ()=>{
+  const { page, errors, close } = await env.page();
+  try {
+    await holdWorkers(page);
+    await openModule(page, 'sem'); await loadFiles(page, 'sem', [A(), B()]);
+    await relabel(page, 0, 'a-one');
+    // (its section, marked: the same element when it is shown again, not a restore's)
+    await page.evaluate(()=>{ document.querySelector('#tab-sem').dataset.mark = 'A'; });
+    await openModule(page, 'sem'); await loadFiles(page, 'sem', [C(), A()]);
+    assert.deepEqual(await awake(page), [true, true], 'both awake');
+    assert.equal(await page.locator('#tab-sem').count(), 1, 'one SEM section in the page, the one on show');
+    assert.equal(await page.locator('#semFileTableWrap tr.file-row').count(), 2);
+    assert.equal(await page.evaluate(()=> window.__made), 1, 'one reading worker for both tabs');
+    assert.ok(await page.evaluate(async ()=>{
+      const u = await import('./utils.js'), [a, b] = (await import('./tabs.js')).tabsNow().map(t=> u.getModuleState(t.id));
+      return a.files[0].raw.bytes === b.files[1].raw.bytes;
+    }), 'a.tif in both tabs: one array of its bytes');
+    await relabel(page, 0, 'c-one');
+    await switchTab(page, 0);
+    assert.equal(await page.evaluate(()=> document.querySelector('#tab-sem').dataset.mark), 'A', 'tab A\'s own section, shown again');
+    assert.deepEqual(await labels(page), ['a-one', 'B']);
+    await thumbs(page, 2);
+    assert.deepEqual(await history(page, 'sem'), { index: 2, n: 3 }, 'its history: start, files, label');
+    await relabel(page, 1, 'b-two');
+    // Undo in A undoes A's steps alone; B keeps its own.
+    await undo(page); await undo(page);
+    assert.deepEqual(await labels(page), ['A', 'B']);
+    await switchTab(page, 1);
+    assert.deepEqual(await labels(page), ['c-one', 'A']);
+    await undo(page);
+    assert.deepEqual(await labels(page), ['C', 'A']);
+    await switchTab(page, 0);
+    await undo(page, true);
+    assert.deepEqual(await labels(page), ['a-one', 'B'], 'A\'s redo, after B\'s undo');
+    assert.deepEqual(errors, []);
+  } finally { await close(); }
+});
+
+test('a reading goes on in a tab left: nothing asked, its files in its own list as one step, its record and its "*"; awake till its end, its time hidden counted from then', async ()=>{
+  const { page, errors, close } = await env.page();
+  try {
+    await holdWorkers(page);
+    await openModule(page, 'sem');
+    await page.evaluate(()=>{ window.__hold = true; });
+    await page.setInputFiles('#semFiles', [A(), C()]);
+    await until(()=> page.evaluate(()=> window.__held.length), { what: 'the worker\'s answer' });
+    // Left for another SEM tab: nothing asked, the reading goes on there.
+    await openModule(page, 'sem');
+    assert.equal(await banner(page), null, 'nothing asked');
+    assert.equal((await tabs(page))[0].busy, true, 'still reading, hidden');
+    await tick(page, 11*MIN);
+    assert.deepEqual(await awake(page), [true, true], 'busy: awake past the minutes');
+    await page.evaluate(()=> window.__release());
+    await until(async ()=> !(await tabs(page))[0].busy, { what: 'the reading\'s end' });
+    assert.deepEqual(await labels(page), [], 'the tab on show untouched');
+    // Its record has the files (the autosave of a tab not on show), its label the "*".
+    await until(async ()=>{ const r = (await idb(page, 'tabs')).find(x=> x.order === 0); return r && r.state.files.length === 2; }, { what: 'the record' });
+    assert.match((await tabLabels(page))[0], /\*$/);
+    await tick(page, 9*MIN);
+    assert.deepEqual(await awake(page), [true, true], '9 minutes after its end: awake');
+    await tick(page, 11*MIN);
+    assert.deepEqual(await awake(page), [false, true], '11 minutes after: asleep');
+    // Woken with what it read, drawn.
+    await switchTab(page, 0);
+    assert.deepEqual(await labels(page), ['A', 'C']);
+    await thumbs(page, 2);
+    assert.ok(await page.locator('#semGroups .sem-gimg canvas').count() === 2, 'its cards drawn on show');
+    await undo(page);
+    assert.deepEqual(await labels(page), [], 'its files one step');
+    assert.deepEqual(errors, []);
+  } finally { await close(); }
+});
+
+test('hidden: the editor\'s image let go at once, what it drew at its trim, drawn again on show; asleep past Settings\' minutes, woken with its whole history', async ()=>{
+  const { page, errors, close } = await env.page();
+  try {
+    await page.click('#nav button[data-tab="settings"]');
+    await page.fill('#settingSleepMin', '10'); await page.press('#settingSleepMin', 'Enter');
+    await settle(page);
+    await openModule(page, 'sem'); await loadFiles(page, 'sem', [A(), B(), C()]);
+    for (const v of ['x', 'y']) await relabel(page, 0, v);
+    const hA = await history(page, 'sem');
+    await thumbs(page, 3);
+    const shownBytes = (await tabs(page))[0].bytes;
+    // Hidden: the editor's image (256 × 256 px: its canvas, 0.25 MB, and its pixels while
+    // kept, 2 s after it was made) let go.
+    await openModule(page, 'sem');
+    const hid = (await tabs(page))[0];
+    assert.ok(shownBytes - hid.bytes >= 4*256*256, `${shownBytes} → ${hid.bytes}`);
+    // Trimmed after a minute hidden: its thumbnails, cards and panes let go.
+    await tick(page, 61000);
+    const tr = (await tabs(page))[0];
+    assert.equal(tr.trimmed, true);
+    assert.ok(tr.bytes < hid.bytes, `${hid.bytes} → ${tr.bytes}`);
+    await switchTab(page, 0);
+    await thumbs(page, 3);
+    assert.equal(await page.locator('#semGroups .sem-gimg canvas').count(), 3, 'its cards drawn again');
+    assert.ok(await page.evaluate(()=> document.querySelector('#semCropCanvas').width > 0), 'its editor drawn again');
+    assert.deepEqual(await labels(page), ['y', 'B', 'C']);
+    // Asleep after the minutes set, its history parked with it.
+    await switchTab(page, 1);
+    await tick(page, 11*MIN);
+    assert.deepEqual(await awake(page), [false, true]);
+    assert.equal((await tabs(page))[0].history, true);
+    // Woken: its state and its whole history, step by step.
+    await switchTab(page, 0);
+    assert.deepEqual(await awake(page), [true, true]);
+    assert.deepEqual(await labels(page), ['y', 'B', 'C']);
+    await thumbs(page, 3);
+    assert.deepEqual(await history(page, 'sem'), hA);
+    for (const v of ['x', 'A']){ await undo(page); assert.equal((await labels(page))[0], v); }
+    await undo(page);
+    assert.deepEqual(await labels(page), [], 'down to the empty start');
+    for (let i = 0; i < 3; i++) await undo(page, true);
+    assert.deepEqual(await labels(page), ['y', 'B', 'C'], 'and up again');
+    await thumbs(page, 3);
+    assert.deepEqual(errors, []);
+  } finally { await close(); }
+});
diff --git a/tests/b2xrd.test.mjs b/tests/b2xrd.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..086f0d5367807eb754f7461abc423fc67f123928
--- /dev/null
+++ b/tests/b2xrd.test.mjs
@@ -0,0 +1,222 @@
+/* XRPD made per tab (b2): each XRPD tab an instance of its own, awake while it is shown or
+   was lately, in one page. Two tabs awake at once, each its own files, view and undo
+   history, a switch to one awake only showing it (the same section, nothing restored, no
+   loader); a refinement going on in a tab left, on the workers' pool, its results those of
+   one refined on show, written into its history and its record, its tab marked unsaved; a
+   tab hidden past Settings' minutes asleep (tabs.js sleepTick: the time taken to be later),
+   one busy not until its job's end, the one hidden longest asleep beyond the tabs awake
+   allowed (by number, or by memory), woken with its whole history; a hidden tab saved as
+   it is closed, reopened from Projects; a reload, the tab on show awake and the others
+   asleep until shown. The workers' answers held where a run must go on (window.__hold). */
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { start, openModule, loadFiles, switchTab, settle, undo, moduleState, history, idb, banner, answer, saveAs,
+         openProject, until, tabLabels, ready } from './helpers.mjs';
+
+let env;
+before(async ()=>{ env = await start(); });
+after(()=> env && env.close());
+
+const P = '#xrdR2';
+// The shell's tabs (tabs.js tabsNow), and its rules run as if `ms` had passed.
+const tabs = page => page.evaluate(async ()=> (await import('./tabs.js')).tabsNow());
+const awake = async page => (await tabs(page)).map(t=> t.awake);
+const tick = (page, ms)=> page.evaluate(async ms=> (await import('./tabs.js')).sleepTick(Date.now() + ms), ms);
+const MIN = 60000;
+const labels = async page => (await moduleState(page, 'xrd')).files.map(f=> f.label);
+async function relabel(page, i, v){ const l = page.locator(`#xrdFileTableWrap .file-label[data-i="${i}"]`); await l.fill(v); await l.press('Enter'); await settle(page); }
+// The workers' results held while __hold, delivered by __release(); before any worker is made.
+const holdWorkers = page => page.evaluate(()=>{
+  const W = window.Worker; window.__held = []; window.__hold = false;
+  const wrap = fn => e=>{ if (window.__hold && e.data && e.data.type === 'result') window.__held.push(()=> fn(e)); else fn(e); };
+  window.Worker = class extends W {
+    addEventListener(t, fn, o){ if (t !== 'message') return super.addEventListener(t, fn, o); const g = wrap(fn); (this.__m || (this.__m = new Map())).set(fn, g); return super.addEventListener(t, g, o); }
+    removeEventListener(t, fn, o){ return super.removeEventListener(t, (t === 'message' && this.__m && this.__m.get(fn)) || fn, o); }
+  };
+  window.__release = ()=>{ window.__hold = false; window.__held.splice(0).forEach(f=> f()); };
+});
+const press = async (page, sel)=>{ await page.waitForTimeout(650); await page.click(sel); };
+async function refineAll(page){
+  await press(page, P + 'RefineAll');
+  await page.waitForSelector('.confirm-modal');
+  await page.click('.confirm-modal .btn:not(.primary)');
+  await page.waitForFunction(s=> document.querySelector(s).textContent === 'Cancel', P + 'Refine');
+}
+// A new XRPD tab of n patterns and the CIF on its Rietveld card.
+async function xrdTab(page, n){
+  await openModule(page, 'xrd');
+  await loadFiles(page, 'xrd', env.fx.files.xrd.slice(0, n));
+  await page.setInputFiles(P + 'CifInput', env.fx.cif);
+  await page.waitForSelector(P + 'PhaseList input[data-on]');
+  await settle(page);
+}
+const results = async page => (((await moduleState(page, 'xrd')).cards.find(c=> c.id === 2) || {}).states?.rietveld?.results || {});
+// (what the worker gave, its times left out)
+const strip = r => JSON.parse(JSON.stringify(r, (k, v)=> k === 'at' || k === 'ms' ? undefined : v));
+
+test('two XRPD tabs awake at once: each its own files, view and undo; a switch to one awake only shows it', async ()=>{
+  const { page, errors, close } = await env.page();
+  try {
+    await openModule(page, 'xrd'); await loadFiles(page, 'xrd', env.fx.files.xrd.slice(0, 2));
+    await relabel(page, 0, 'a-one');
+    // (its section, marked: the same element when it is shown again, not a restore's)
+    await page.evaluate(()=>{ document.querySelector('#tab-xrd').dataset.mark = 'A'; });
+    await openModule(page, 'xrd'); await loadFiles(page, 'xrd', env.fx.files.xrd.slice(2, 3));
+    assert.deepEqual(await awake(page), [true, true], 'both awake');
+    assert.equal(await page.locator('#tab-xrd').count(), 1, 'one XRPD section in the page, the one on show');
+    assert.equal(await page.locator('#xrdFileTableWrap tr.file-row').count(), 1);
+    await relabel(page, 0, 'b-one');
+    await switchTab(page, 0);
+    assert.equal(await page.evaluate(()=> document.querySelector('#tab-xrd').dataset.mark), 'A', 'tab A\'s own section, shown again');
+    assert.deepEqual(await labels(page), ['a-one', 's01']);
+    assert.deepEqual(await history(page, 'xrd'), { index: 2, n: 3 }, 'its history: start, files, label');
+    await relabel(page, 1, 'a-two');
+    // Undo in A undoes A's steps alone; B keeps its own.
+    await undo(page); await undo(page);
+    assert.deepEqual(await labels(page), ['s00', 's01']);
+    await switchTab(page, 1);
+    assert.deepEqual(await labels(page), ['b-one']);
+    await undo(page);
+    assert.deepEqual(await labels(page), ['s02']);
+    await switchTab(page, 0);
+    await undo(page, true);
+    assert.deepEqual(await labels(page), ['a-one', 's01'], 'A\'s redo, after B\'s undo');
+    assert.deepEqual(errors, []);
+  } finally { await close(); }
+});
+
+test('a refinement goes on in a tab left, on the pool: the results of one refined on show, its history\'s step, its record, its "*"', async ()=>{
+  const { page, errors, close } = await env.page();
+  try {
+    await xrdTab(page, 3);
+    await refineAll(page);
+    // Left at once for another XRPD tab: nothing asked, the run goes on there.
+    await openModule(page, 'xrd');
+    assert.equal(await banner(page), null, 'nothing asked');
+    assert.equal((await tabs(page))[0].busy, true, 'still refining, hidden');
+    await until(async ()=> !(await tabs(page))[0].busy, { timeout: 120000, what: 'the hidden run\'s end' });
+    // Its record has the results (the autosave of a tab not on show), its label the "*".
+    await until(async ()=> { const r = (await idb(page, 'tabs')).find(x=> x.order === 0); return r && Object.keys(r.state.cards.find(c=> c.id === 2).states.rietveld.results || {}).length === 3; }, { what: 'the record' });
+    assert.match((await tabLabels(page))[0], /\*$/);
+    assert.deepEqual(await labels(page), [], 'the tab on show untouched');
+    await switchTab(page, 0);
+    const hidden = strip(await results(page));
+    assert.deepEqual(Object.keys(hidden), ['s00.xrdml', 's01.xrdml', 's02.xrdml']);
+    // Its plot drawn as it is shown: the observed, calculated, background and difference.
+    assert.ok(await page.locator(P + 'Svg path').count() >= 4, 'drawn on show');
+    const h = await history(page, 'xrd');
+    await undo(page);
+    assert.deepEqual(Object.keys(await results(page)), [], 'its step undone');
+    await undo(page, true);
+    assert.equal((await history(page, 'xrd')).index, h.index);
+    // The same refined on show, in a third tab.
+    await xrdTab(page, 3);
+    await refineAll(page);
+    await page.waitForFunction(s=> document.querySelector(s).textContent === 'Refine', P + 'Refine', { timeout: 120000 });
+    await settle(page);
+    assert.deepEqual(strip(await results(page)), hidden, 'bit for bit');
+    assert.deepEqual(errors, []);
+  } finally { await close(); }
+});
+
+test('asleep past Settings\' minutes, a busy tab not until its job\'s end, the one hidden longest beyond the tabs awake allowed; woken with its whole history', async ()=>{
+  const { page, errors, close } = await env.page();
+  try {
+    await holdWorkers(page);
+    // Settings › Tabs in the background: 10 minutes, one tab awake not on show.
+    await page.click('#nav button[data-tab="settings"]');
+    await page.fill('#settingSleepMin', '10'); await page.press('#settingSleepMin', 'Enter');
+    await page.selectOption('#settingLivePolicy', 'count');
+    await page.fill('#settingLiveMax', '1'); await page.press('#settingLiveMax', 'Enter');
+    await settle(page);
+    // A: two patterns, three steps of labels.
+    await openModule(page, 'xrd'); await loadFiles(page, 'xrd', env.fx.files.xrd.slice(0, 2));
+    for (const v of ['x', 'y', 'z']) await relabel(page, 0, v);
