+const lru = async page =>{ const t = (await tabs(page)).filter(x=> !x.shown), a = t.filter(x=> x.awake), s = t.filter(x=> !x.awake && x.seenAt);
+  return !a.length || !s.length || Math.max(...s.map(x=> x.seenAt)) <= Math.min(...a.map(x=> x.seenAt)); };
