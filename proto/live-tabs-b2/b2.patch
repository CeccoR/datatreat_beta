+const A = ()=> tif('a.tif', { sign: 'A', seed: 1, pixelNm: 25, mag: 5000, bits: 16 });
+const B = ()=> tif('b.tif', { sign: 'B', seed: 2, pixelNm: 25, mag: 5000 });
