+    constructor(...a){ super(...a); window.__made++; }
+    set onmessage(fn){ super.onmessage = fn && wrap(fn); }
+    get onmessage(){ return super.onmessage; }
+  };
+  window.__release = ()=>{ window.__hold = false; window.__held.splice(0).forEach(f=> f()); };
