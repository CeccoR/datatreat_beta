## The repro scripts (the check's, scratchpad b2v3/check/r3/scripts; fixed.mjs and behind.mjs mine, b2v3/final/scripts)
superseded.mjs (lim-lib, LIM_PROFILE=disk; X an XRPD tab of 12 refined, left at 1400; at 1180, X then H clicked in one task; X shown):
  v3c: X.view 1180@1, loaderShown false, long tasks ["128!"] (! not under the loader), errors []
  w: X.view 1400@1, loaderShown true, long tasks ["68","117"] (! not under the loader), errors []
quick2.mjs (two GC tabs, at 1200 T1 then Settings clicked in one task; the sections on show 800 ms later):
  v3c: {"sections":["tab-gc"]}
  w:   {"sections":["tab-settings"]}
fixed.mjs (the same, the switch's microtask let through before Settings is clicked; A: T1 awake, left at 1400; B: T1 asleep):
  v3c A: {"pending":true,"after":{"sections":["tab-gc"],"awake":[true,true],"view":null},"loaderOnShow":false}
  v3c B: {"pending":true,"after":{"sections":["tab-gc"],"awake":[true,true],"view":null},"loaderOnShow":false}
  w   A: {"pending":true,"after":{"sections":["tab-settings"],"awake":[true,true],"view":"1400@1"},"loaderOnShow":true,"shown":{"sections":["tab-gc"],"view":null}}
  w   B: {"pending":true,"after":{"sections":["tab-settings"],"awake":[true,false],"view":"1400@1"},"loaderOnShow":true,"shown":{"sections":["tab-gc"],"awake":[true,true],"view":null}}
behind.mjs (w only: T1 asleep chosen, Settings within the frames, then ensureLive from Settings, as a close's Save):
  w: {"chosen":{"sections":["tab-settings"],"awake":[true,false]},"woken":{"sections":["tab-settings"],"awake":[true,true],"view":""},"loaderOnShow":true,"shown":{"sections":["tab-gc"],"view":null}}
cards.mjs 1 (SEM, crop 128 made and undone twice; a.tif read again in a new tab; back, redone twice; the cards made by the redo):
  v3c: {"reread":true,"cropMade":2,"undoMade":0,"showMade":0,"redoMade":1} errors []
  w:   {"reread":true,"cropMade":2,"undoMade":0,"showMade":0,"redoMade":0} errors []

