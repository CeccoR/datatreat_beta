+       (tabs.js): its elements and its plots, not its files' arrays, which its parked state
+       and its history keep. Measured, the renderer's RSS of 5 tabs awake and hidden over 5
+       asleep (NOTES-gc-epr.md): blank none (246 nodes); exports of 72 injections, H2 and
+       O2, one card, 3 of them 1.1 MB, 10 2.3 MB; 10 and two cards 4.2. So: 64 kB, and with
+       files 0.57 MB a card and 0.17 MB a file a card. */
+    bytes(){ return (1 << 16) + (files.length ? cards().length*(600e3 + 175e3*files.length) : 0); },
+  };
+}
+registerModule('gc', createGc);
