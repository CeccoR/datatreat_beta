+
+let env;
+before(async ()=>{ env = await start(); });
+after(()=> env && env.close());
+
+const P = '#xrdR2';
+// The Rietveld workers' results held while window.__hold: __one() delivers the earliest
+// job's of those held (the patterns' order), __release() every one and holds no more.
+// Before any worker is made.
+const holdWorkers = page => page.evaluate(()=>{
+  const W = window.Worker; window.__held = []; window.__hold = false;
+  const wrap = fn => e=>{ if (window.__hold && e.data && e.data.type === 'result') window.__held.push(Object.assign(()=> fn(e), { k: e.data.id ?? e.data.seq ?? 0 })); else fn(e); };
+  window.Worker = class extends W {
+    addEventListener(t, fn, o){ if (t !== 'message') return super.addEventListener(t, fn, o); const g = wrap(fn); (this.__m || (this.__m = new Map())).set(fn, g); return super.addEventListener(t, g, o); }
+    removeEventListener(t, fn, o){ return super.removeEventListener(t, (t === 'message' && this.__m && this.__m.get(fn)) || fn, o); }
+  };
+  window.__one = ()=>{ const h = window.__held; if (!h.length) return false; let j = 0; h.forEach((f, i)=>{ if (f.k < h[j].k) j = i; }); h.splice(j, 1)[0](); return true; };
+  window.__release = ()=>{ window.__hold = false; window.__held.splice(0).forEach(f=> f()); };
+});
+const held = (page, n = 1)=> until(()=> page.evaluate(n=> window.__held.length >= n, n), { timeout: 120000, what: 'the worker\'s answer' });
+const one = async page =>{ await held(page); await page.evaluate(()=> window.__one()); };
+const press = async (page, sel)=>{ await page.waitForTimeout(650); await page.click(sel); };
+const running = page => page.waitForFunction(s=> document.querySelector(s).textContent === 'Cancel', P + 'Refine');
+// Refine all, without the standard; it runs.
+async function refineAll(page){
+  await press(page, P + 'RefineAll');
+  await page.waitForSelector('.confirm-modal');
+  await page.click('.confirm-modal .btn:not(.primary)');
+  await running(page);
+}
+// An XRPD tab of n patterns and the CIF on card 2, on show.
+async function xrdTab(page, n){
+  await openModule(page, 'xrd');
+  await loadFiles(page, 'xrd', env.fx.files.xrd.slice(0, n));
+  await page.setInputFiles(P + 'CifInput', env.fx.cif);
+  await page.waitForSelector(P + 'PhaseList input[data-on]');
+  await settle(page);
+}
+const show = async (page, i)=>{ await page.locator('#tabBar .ptab').nth(i).locator('.ptab-label').click(); await settle(page); };
+const res = (s, id = 2)=> Object.keys((((s && s.cards || []).find(c=> c.id === id) || {}).states || {}).rietveld?.results || {});
+// Tab i as the tab manager holds it: its parked state's results (card 2's, the standard's),
